# Python Code Obfuscation using Bytecode Compilation
# This Dockerfile compiles Python source to .pyc bytecode and removes source files
# Provides reasonable protection against casual code inspection

FROM python:3.9-slim

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Set working directory
WORKDIR /app

# Install system dependencies (required for Selenium/Chrome automation)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    fonts-liberation \
    gnupg \
    wget \
    curl \
    build-essential \
    chromium \
    chromium-driver \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libc6 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libexpat1 \
    libfontconfig1 \
    libgbm1 \
    libgcc1 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libstdc++6 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    lsb-release \
    xdg-utils \
    xvfb \
    && rm -rf /var/lib/apt/lists/*

# Create directory for ChromeDriver with proper permissions
RUN mkdir -p /root/.cache/selenium/chromedriver/linux64 \
    && chmod -R 777 /root/.cache/selenium

# Upgrade pip
RUN pip install --upgrade pip

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy all application code
COPY . .

# 🔒 OBFUSCATION STEP - Compile to bytecode and remove source files
RUN echo "🔒 Starting code obfuscation..." && \
    # Compile all Python files to .pyc bytecode
    python -m compileall -b /app && \
    echo "✅ Bytecode compilation complete" && \
    # Remove .py source files (preserve critical entry points and migrations)
    find /app -type f -name "*.py" \
        ! -name "__init__.py" \
        ! -name "main.py" \
        ! -path "*/migrations/*" \
        -delete && \
    echo "✅ Source files removed" && \
    # Clean up __pycache__ directories
    find /app -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true && \
    echo "✅ Cache cleanup complete" && \
    echo "🔒 Code obfuscation finished!"

# Verify obfuscation worked
RUN echo "📊 Obfuscation verification:" && \
    echo "  .pyc files: $(find /app -name '*.pyc' | wc -l)" && \
    echo "  .py files remaining: $(find /app -name '*.py' ! -path '*/migrations/*' | wc -l)"

# Expose application port
EXPOSE 8000

# Run application using bytecode
# -B flag prevents creation of .pyc files during runtime
CMD ["python", "-B", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
