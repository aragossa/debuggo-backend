[
    {
        "id": 1,
        "name": "API TESTS",
        "type": "root",
        "children": [
            {
                "id": 2,
                "name": "User API Tests",
                "type": "group",
                "children": [
                    {
                        "id": 3,
                        "name": "GET /users - Retrieve all users",
                        "type": "test",
                        "curl": "curl -X GET https://api.sample.com/v1/users",
                        "expected_result": "Response code: 200; Response body: Array of User objects"
                    },
                    {
                        "id": 4,
                        "name": "POST /users - Create a new user",
                        "type": "test",
                        "curl": "curl -X POST https://api.sample.com/v1/users -H 'Content-Type: application/json' -d '{\"name\": \"John Doe\", \"email\": \"john@example.com\"}'",
                        "expected_result": "Response code: 201; Response body: Newly created User object"
                    },
                    {
                        "id": 5,
                        "name": "GET /users/{userId} - Retrieve user by ID",
                        "type": "test",
                        "curl": "curl -X GET https://api.sample.com/v1/users/{userId}",
                        "expected_result": "Response code: 200; Response body: User object"
                    },
                    {
                        "id": 6,
                        "name": "GET /users/{userId} - User not found",
                        "type": "test",
                        "curl": "curl -X GET https://api.sample.com/v1/users/invalidId",
                        "expected_result": "Response code: 404; Response body: Error message"
                    },
                    {
                        "id": 7,
                        "name": "PUT /users/{userId} - Update user details",
                        "type": "test",
                        "curl": "curl -X PUT https://api.sample.com/v1/users/{userId} -H 'Content-Type: application/json' -d '{\"name\": \"Jane Doe\", \"email\": \"jane@example.com\"}'",
                        "expected_result": "Response code: 200; Response body: Updated User object"
                    },
                    {
                        "id": 8,
                        "name": "DELETE /users/{userId} - Delete user",
                        "type": "test",
                        "curl": "curl -X DELETE https://api.sample.com/v1/users/{userId}",
                        "expected_result": "Response code: 204; Response body: No content"
                    }
                ]
            },
            {
